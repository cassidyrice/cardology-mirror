{
  "project": "cardblueprints-astronauts-seo",
  "origin": "https://cardblueprints.com",
  "status": "scaffold-only-do-not-deploy",
  "pages_will_own": [
    "/astronauts",
    "/astronauts/{slug}",
    "/sitemap-astronauts.xml"
  ],
  "never_own": [
    "/birth-card",
    "/birth-card/{slug}",
    "/birth-card/{rank}-of-{suit}",
    "/birth-card/joker",
    "/card/{rank}-of-{suit}",
    "/card/joker",
    "/birthday/{month}-{day}",
    "/today",
    "/checkout",
    "/checkout/*",
    "/api/checkout/*",
    "/create-checkout",
    "/api/*",
    "/products/*"
  ],
  "router_note": "Isolated static prefix. Do not collide with celebrity /birth-card/{person-slug} or live Next.js /birth-card/{rank}-of-{suit}. Do not deploy this dist onto the live Pages project."
}
