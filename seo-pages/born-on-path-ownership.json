{
  "project": "cardblueprints-born-on-grounding",
  "origin": "https://cardblueprints.com",
  "status": "scaffold-only-do-not-deploy",
  "pages_will_own": [
    "/born-on",
    "/born-on/{month}-{day}",
    "/sitemap-born-on.xml"
  ],
  "must_not_own": [
    "/birthday",
    "/birthday/{month}-{day}",
    "/birth-card",
    "/birth-card/{slug}",
    "/birth-card/{rank}-of-{suit}",
    "/birth-card/joker",
    "/checkout",
    "/checkout/*",
    "/create-checkout",
    "/api/*"
  ],
  "utm": {
    "source": "born-on",
    "content": "{slug}"
  },
  "router_note": "Authority upgrade of the live Worker /born-on path. Not a new niche. Not /birthday. Path-split is not activated. Do not deploy this dist onto the live Pages project while the Worker owns the prefix."
}
