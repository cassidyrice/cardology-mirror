# Copy to .env.audit (gitignored). Read-only audit creds.
GOOGLE_SA_JSON_PATH=./ops/audit/gsc-ga4-sa.json   # service account key, covers GSC + GA4
GSC_SITE_URL=sc-domain:cardblueprints.com          # or https://cardblueprints.com/
GA4_PROPERTY_ID=                                   # numeric, GA4 Admin > Property details
CF_API_TOKEN=                                      # Cloudflare token: Account Analytics:Read + Zone Analytics:Read
CF_ZONE_ID=
