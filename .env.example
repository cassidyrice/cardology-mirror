# Stripe — create three Products + Prices in your Stripe dashboard
# matching the $19 / $39 / $199 voice-reading ladder, then paste the
# price IDs here.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_VIDEO_READING=price_xxx_for_99_dollar_video_reading

# Email — Resend used for purchase + webhook notifications.
# Verify a sending domain in Resend, then set INTAKE_FROM_EMAIL to that domain.
RESEND_API_KEY=re_xxx
INTAKE_EMAIL=cass@cardologypro.com
INTAKE_FROM_EMAIL=readings@cardologypro.com

# Site URL — used for Stripe success_url / cancel_url. Defaults to prod.
NEXT_PUBLIC_SITE_URL=https://cardblueprints.com
