# Stripe — create live Products + Prices that match lib/products.ts.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_QUICK_QUESTION=price_xxx_for_19_dollar_quick_question
STRIPE_PRICE_COMPLETE_READING=price_xxx_for_39_dollar_complete_reading
STRIPE_PRICE_SEASON_PASS=price_xxx_for_199_dollar_season_pass
STRIPE_PRICE_PERSONAL_CARD_BLUEPRINT=price_xxx_for_29_dollar_personal_card_blueprint
# Set only after PDF delivery is configured and verified.
STRIPE_PRICE_ANALOG_ALGORITHM=price_xxx_for_27_dollar_analog_algorithm

# Download tokens (HMAC, edge-safe). Falls back to GATE_SECRET if unset.
DOWNLOAD_TOKEN_SECRET=

# Email — Resend used for purchase + webhook notifications.
# Verify a sending domain in Resend, then set INTAKE_FROM_EMAIL to that domain.
RESEND_API_KEY=re_xxx
INTAKE_EMAIL=cass@cardologypro.com
INTAKE_FROM_EMAIL=readings@cardologypro.com

# Site URL — used for Stripe success_url / cancel_url. Defaults to prod.
NEXT_PUBLIC_SITE_URL=https://cardblueprints.com
