# Stripe — active product prices only. Retired phone-reading prices are not
# needed to interpret historical sessions or webhook metadata.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PERSONAL_CARD_BLUEPRINT=price_xxx_for_29_dollar_personal_card_blueprint
# Set only after PDF delivery is configured and verified.
STRIPE_PRICE_ANALOG_ALGORITHM=price_xxx_for_17_dollar_analog_algorithm

# Download tokens (HMAC, edge-safe). Falls back to GATE_SECRET if unset.
DOWNLOAD_TOKEN_SECRET=

# Email — Resend used for purchase + webhook notifications.
# Resend (Elroy micro-reading emails + free-course access emails + contact list).
# CRITICAL: Until a custom domain is verified in Resend, you can only send TO the
# Resend account owner's email, and only FROM onboarding@resend.dev.
# Production visitors will not receive email until DNS is verified.
#
# Setup:
# 1) Create API key at https://resend.com/api-keys
# 2) Add + verify domain (e.g. cardblueprints.com) at https://resend.com/domains
# 3) Set INTAKE_FROM_EMAIL to an address on that domain, e.g.:
#      Card Blueprints <hello@cardblueprints.com>
# 4) Put secrets on Cloudflare Pages (project cardology-mirror), then redeploy.
RESEND_API_KEY=re_xxx
INTAKE_EMAIL=therealcassrice@gmail.com
# Temporary test-only from (only delivers to the Resend account owner):
# INTAKE_FROM_EMAIL=Card Blueprints <onboarding@resend.dev>
# Production from (after domain verify):
INTAKE_FROM_EMAIL=Card Blueprints <hello@cardblueprints.com>

# Site URL — used for Stripe success_url / cancel_url. Defaults to prod.
NEXT_PUBLIC_SITE_URL=https://cardblueprints.com

# Google Analytics 4 Measurement ID (public). Defaults to the Card Blueprints
# property stream if unset. Override only for staging/test properties.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-25K69MTQ4L

