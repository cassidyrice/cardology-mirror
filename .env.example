# Stripe — active product prices only. Retired phone-reading prices are not
# needed to interpret historical sessions or webhook metadata.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PERSONAL_CARD_BLUEPRINT=price_xxx_for_29_dollar_personal_card_blueprint
# Set only after PDF delivery is configured and verified.
STRIPE_PRICE_ANALOG_ALGORITHM=price_xxx_for_17_dollar_analog_algorithm

# My Question remains fail-closed until every gate is explicitly true.
STRIPE_MY_QUESTION_PRICE_ID=price_xxx_for_99_dollar_my_question
STRIPE_QUESTION_BLUEPRINT_PRICE_ID=price_xxx_for_29_dollar_question_blueprint
MY_QUESTION_CHECKOUT_ENABLED=false
MY_QUESTION_PROOF_APPROVED=false
MY_QUESTION_SAMPLE_APPROVED=false
MY_QUESTION_CAPTIONS_APPROVED=false
MY_QUESTION_BLUEPRINT_SAMPLE_APPROVED=false
MY_QUESTION_D1_READY=false
MY_QUESTION_OPS_READY=false
# True only after MiniMax access, privacy handling, and fulfillment procedure are verified.
MY_QUESTION_NARRATION_READY=false
# Generate at least 32 random characters. Never expose this to the browser.
MY_QUESTION_SIGNING_SECRET=
# Automatic refunds after 14 days require separate explicit approval.
MY_QUESTION_AUTO_REFUNDS_ENABLED=false

# Download tokens (HMAC, edge-safe). Falls back to GATE_SECRET if unset.
DOWNLOAD_TOKEN_SECRET=

# Email — Resend used for purchase + webhook notifications.
# Verify a sending domain in Resend, then set INTAKE_FROM_EMAIL to that domain.
RESEND_API_KEY=re_xxx
INTAKE_EMAIL=cass@cardologypro.com
INTAKE_FROM_EMAIL=readings@cardologypro.com

# Site URL — used for Stripe success_url / cancel_url. Defaults to prod.
NEXT_PUBLIC_SITE_URL=https://cardblueprints.com

# Google Analytics 4 Measurement ID (public). Defaults to the Card Blueprints
# property stream if unset. Override only for staging/test properties.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-25K69MTQ4L

# Cloudflare Turnstile (Elroy micro-reading gate)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=cardblueprints.com,www.cardblueprints.com
