{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/mlb.json",
  "title": "MLB franchise first-game birth-card row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "league",
    "division",
    "first_game",
    "first_game_precision",
    "first_game_status",
    "first_season_name",
    "first_game_line",
    "bbref_code",
    "bbref_first_season_code",
    "bbref_first_season_url",
    "bbref_franchise_url",
    "retrosheet_url",
    "notes",
    "wikipedia_first_season_label",
    "wikipedia_years",
    "year_crosscheck",
    "solar_value",
    "card",
    "expansion_1969_04_08_quartet",
    "aa_1882_05_02_trio",
    "same_card_slugs",
    "same_first_game_day_slugs",
    "sources"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "league": { "type": "string", "enum": ["AL", "NL"] },
    "division": {
      "type": "string",
      "enum": ["East", "Central", "West"]
    },
    "first_game": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "first_game_precision": { "type": "string", "const": "day" },
    "first_game_status": { "type": "string", "const": "verified" },
    "first_season_name": { "type": "string", "minLength": 1 },
    "first_game_line": { "type": "string", "minLength": 1 },
    "bbref_code": { "type": "string", "minLength": 2, "maxLength": 3 },
    "bbref_first_season_code": { "type": "string", "minLength": 2, "maxLength": 3 },
    "bbref_first_season_url": { "type": "string", "minLength": 1 },
    "bbref_franchise_url": { "type": "string", "minLength": 1 },
    "retrosheet_url": { "type": "string", "minLength": 1 },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "wikipedia_first_season_label": { "type": "string", "minLength": 1 },
    "wikipedia_years": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 1
    },
    "year_crosscheck": {
      "type": "string",
      "enum": [
        "year_mentioned",
        "first_game_precedes_wikipedia_join",
        "wikipedia_lists_older_year"
      ]
    },
    "solar_value": { "type": "integer", "minimum": 1, "maximum": 52 },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rank",
        "suit",
        "label",
        "slug",
        "symbol",
        "archetype",
        "meaning_page",
        "core_identity",
        "sweet_spot",
        "life_direction"
      ],
      "properties": {
        "kind": { "type": "string", "const": "card" },
        "rank": { "type": "string" },
        "suit": {
          "type": "string",
          "enum": ["hearts", "clubs", "diamonds", "spades"]
        },
        "label": { "type": "string" },
        "slug": {
          "type": "string",
          "pattern": "^(ace|[2-9]|10|jack|queen|king)-of-(hearts|diamonds|clubs|spades)$"
        },
        "symbol": { "type": "string" },
        "archetype": { "type": "string" },
        "meaning_page": { "type": "string" },
        "core_identity": { "type": "string" },
        "sweet_spot": { "type": "string" },
        "life_direction": { "type": "string" }
      }
    },
    "expansion_1969_04_08_quartet": { "type": "boolean" },
    "aa_1882_05_02_trio": { "type": "boolean" },
    "same_card_slugs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "same_first_game_day_slugs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "url", "role", "retrieved"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "primary_first_game",
              "game_log_corroboration",
              "year_crosscheck_only"
            ]
          },
          "retrieved": { "type": "string" },
          "license": { "type": "string" }
        }
      }
    }
  }
}
