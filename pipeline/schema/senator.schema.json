{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/senator.json",
  "title": "Current US senator birth-card person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qid",
    "name",
    "slug",
    "state",
    "state_slug",
    "postal",
    "senate_class",
    "party",
    "bioguide",
    "birth_date",
    "death_date",
    "card",
    "source_text",
    "source_url",
    "wikipedia_title",
    "wikipedia_list_date",
    "wikidata_birth_date",
    "bioguide_birth_date",
    "dob_crosscheck",
    "bioguide_url",
    "congress_url"
  ],
  "properties": {
    "qid": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "state_slug": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)*$"
    },
    "postal": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "senate_class": {
      "type": "string",
      "pattern": "^[123]$"
    },
    "party": {
      "type": "string",
      "minLength": 1
    },
    "bioguide": {
      "type": "string",
      "minLength": 1
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "death_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "card": {
      "type": "string",
      "pattern": "^(Joker|([A2-9JQK]|10)[♥♣♦♠])$"
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_title": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_list_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "wikidata_birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "bioguide_birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dob_crosscheck": {
      "type": "string",
      "const": "match"
    },
    "bioguide_url": {
      "type": "string",
      "minLength": 1
    },
    "congress_url": {
      "type": "string",
      "minLength": 1
    }
  }
}
