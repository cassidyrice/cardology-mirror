{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/scotus.json",
  "title": "Current SCOTUS justice birth-card person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qid",
    "name",
    "slug",
    "role",
    "seniority",
    "birth_date",
    "death_date",
    "card",
    "source_text",
    "source_url",
    "wikipedia_title",
    "scotus_url",
    "scotus_birth_date",
    "wikidata_birth_date",
    "dob_crosscheck"
  ],
  "properties": {
    "qid": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "role": {
      "type": "string",
      "enum": ["Chief Justice of the United States", "Associate Justice"]
    },
    "seniority": {
      "type": "integer",
      "minimum": 1
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "death_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "card": {
      "type": "string",
      "pattern": "^(Joker|([A2-9JQK]|10)[♥♣♦♠])$"
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_title": {
      "type": "string",
      "minLength": 1
    },
    "scotus_url": {
      "type": "string",
      "minLength": 1
    },
    "scotus_birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "wikidata_birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dob_crosscheck": {
      "type": "string",
      "const": "match"
    }
  }
}
