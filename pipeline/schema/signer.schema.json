{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/signer.json",
  "title": "Declaration signer birth-card person (verified subset)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qid",
    "name",
    "slug",
    "colony",
    "colony_code",
    "birth_date",
    "death_date",
    "card",
    "source_text",
    "source_url",
    "wikipedia_title",
    "bioguide_id",
    "nara_birth_raw",
    "wikipedia_birth",
    "dob_crosscheck",
    "calendar_note",
    "footnote",
    "wikidata_date",
    "wikidata_precision",
    "wikidata_qa"
  ],
  "properties": {
    "qid": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "colony": {
      "type": "string",
      "minLength": 1
    },
    "colony_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "death_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "card": {
      "type": "string",
      "pattern": "^(Joker|([A2-9JQK]|10)[♥♣♦♠])$"
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_title": {
      "type": "string",
      "minLength": 1
    },
    "bioguide_id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{6}$"
    },
    "nara_birth_raw": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_birth": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dob_crosscheck": {
      "type": "string",
      "enum": ["match", "mismatch", "new_style", "missing"]
    },
    "calendar_note": {
      "type": "string",
      "enum": ["new_style", "nara_day"]
    },
    "footnote": {
      "type": ["string", "null"]
    },
    "wikidata_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "wikidata_precision": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 14
    },
    "wikidata_qa": {
      "type": "string",
      "enum": ["match", "mismatch", "missing", "year_only"]
    }
  }
}
