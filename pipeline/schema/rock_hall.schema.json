{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/rock-hall.json",
  "title": "Rock & Roll Hall of Fame performer birth-card person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qid",
    "name",
    "slug",
    "birth_date",
    "death_date",
    "card",
    "source_text",
    "source_url",
    "wikipedia_title",
    "rockhall_url",
    "wikipedia_list_url",
    "primary_role",
    "inductions",
    "wikipedia_infobox_date",
    "wikidata_birth_date",
    "dob_crosscheck"
  ],
  "properties": {
    "qid": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "death_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "card": {
      "type": "string",
      "pattern": "^(Joker|([A2-9JQK]|10)[♥♣♦♠])$"
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_title": {
      "type": "string",
      "minLength": 1
    },
    "rockhall_url": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_list_url": {
      "type": "string",
      "minLength": 1
    },
    "primary_role": {
      "type": "string",
      "enum": ["solo", "member"]
    },
    "inductions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "act",
          "act_wikipedia_title",
          "category",
          "category_id",
          "role",
          "rockhall_url"
        ],
        "properties": {
          "year": { "type": "string", "pattern": "^[0-9]{4}$" },
          "act": { "type": "string", "minLength": 1 },
          "act_wikipedia_title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "category_id": { "type": "string", "const": "performers" },
          "role": { "type": "string", "enum": ["solo", "member"] },
          "rockhall_url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "wikipedia_infobox_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "wikidata_birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dob_crosscheck": {
      "type": "string",
      "const": "match"
    }
  }
}
