{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/person.json",
  "title": "Celebrity birth-card person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qid",
    "name",
    "slug",
    "birth_date",
    "card",
    "views",
    "occupations",
    "spouse_qids",
    "image",
    "source_text",
    "source_url"
  ],
  "properties": {
    "qid": {
      "type": "string",
      "pattern": "^Q[0-9A-Z]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "card": {
      "type": "string",
      "pattern": "^(Joker|([A2-9JQK]|10)[♥♣♦♠])$"
    },
    "views": {
      "type": "integer",
      "minimum": 0
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spouse_qids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Q[0-9A-Z]+$"
      }
    },
    "image": {
      "type": ["string", "null"]
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    }
  }
}
