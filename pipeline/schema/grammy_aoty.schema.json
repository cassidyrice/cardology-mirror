{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/grammy_aoty.json",
  "title": "Grammy Album of the Year birth-card person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qid",
    "name",
    "slug",
    "birth_date",
    "death_date",
    "card",
    "source_text",
    "source_url",
    "wikipedia_title",
    "grammy_url",
    "billing",
    "billed_act",
    "awards",
    "wikipedia_infobox_date",
    "wikidata_birth_date",
    "dob_crosscheck"
  ],
  "properties": {
    "qid": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "death_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "card": {
      "type": "string",
      "pattern": "^(Joker|([A2-9JQK]|10)[♥♣♦♠])$"
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_title": {
      "type": "string",
      "minLength": 1
    },
    "grammy_url": {
      "type": "string",
      "minLength": 1
    },
    "billing": {
      "type": "string",
      "enum": ["primary", "band_member"]
    },
    "billed_act": {
      "type": "string",
      "minLength": 1
    },
    "awards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "ceremony_number",
          "album",
          "grammy_url",
          "billed_act",
          "category",
          "category_id"
        ],
        "properties": {
          "year": { "type": "string", "pattern": "^[0-9]{4}$" },
          "ceremony_number": { "type": "integer", "minimum": 1 },
          "album": { "type": "string", "minLength": 1 },
          "grammy_url": { "type": "string", "minLength": 1 },
          "billed_act": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "category_id": { "type": "string", "const": "album-of-the-year" }
        }
      }
    },
    "wikipedia_infobox_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "wikidata_birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dob_crosscheck": {
      "type": "string",
      "const": "match"
    }
  }
}
