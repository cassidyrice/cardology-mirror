{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardblueprints.com/schema/born-on-person.json",
  "title": "Born-on notable person (day-precision Wikidata P569)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qid",
    "name",
    "slug",
    "birth_date",
    "wikidata_birth_date",
    "card",
    "views",
    "source_text",
    "source_url",
    "wikipedia_title",
    "month",
    "day"
  ],
  "properties": {
    "qid": {
      "type": "string",
      "pattern": "^Q[0-9A-Z]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "wikidata_birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "card": {
      "type": "string",
      "pattern": "^(Joker|([A2-9JQK]|10)[♥♣♦♠])$"
    },
    "views": {
      "type": "integer",
      "minimum": 0
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "wikipedia_title": {
      "type": "string",
      "minLength": 1
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    }
  }
}
